{
  "name": "hmcts-template-preview",
  "displayName": "HMCTS Template Preview",
  "description": "Preview Docmosis .docx templates through the hosted dtsse-doc-render service (VPN), and browse, preview and draft changes to GOV.UK Notify templates.",
  "version": "0.1.0",
  "publisher": "hmcts",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1d70b8",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hmcts/dtsse-docmosis-tools.git",
    "directory": "vscode"
  },
  "homepage": "https://github.com/hmcts/dtsse-docmosis-tools/tree/master/vscode#readme",
  "bugs": {
    "url": "https://github.com/hmcts/dtsse-docmosis-tools/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "docmosis",
    "hmcts",
    "template",
    "docx",
    "preview",
    "pdf",
    "dtsse-doc-render",
    "gov.uk notify",
    "notify",
    "email",
    "sms"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:hmctsTemplatePreview.docxPreview",
    "onCommand:hmctsTemplatePreview.preview",
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "HMCTS Template Preview",
      "properties": {
        "hmctsTemplatePreview.terminalCommand": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Add the `docmosis` command to the PATH of integrated terminals. Applies to terminals opened after the change."
        },
        "hmctsTemplatePreview.templateLibraries": {
          "type": "array",
          "default": [
            {
              "repo": "hmcts/rdo-docmosis",
              "path": "Templates"
            }
          ],
          "markdownDescription": "GitHub repositories whose `.docx` templates the **Templates** view lists. Defaults to the `Templates` folder of `hmcts/rdo-docmosis`. Setting this replaces the default: to keep it alongside other repositories, include it in the list. Set it to `[]` to list none. The repositories don't need to be cloned: the view reads the file list from GitHub and downloads a template when you open it.",
          "items": {
            "type": "object",
            "required": [
              "repo"
            ],
            "additionalProperties": false,
            "properties": {
              "repo": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$",
                "markdownDescription": "The repository, as `owner/name`."
              },
              "ref": {
                "type": "string",
                "markdownDescription": "Branch, tag or commit to list. Defaults to the repository's default branch."
              },
              "path": {
                "type": "string",
                "markdownDescription": "Folder in the repository to list, for example `templates/letters`. Defaults to the whole repository."
              },
              "label": {
                "type": "string",
                "markdownDescription": "Name shown for the library when several are configured."
              }
            }
          }
        },
        "hmctsTemplatePreview.notify.products": {
          "type": "array",
          "default": [],
          "markdownDescription": "GOV.UK Notify products to add to the built-in list, or to replace a built-in entry with the same `id`. Each entry names the AAT Key Vault and secret holding the product's Notify API key, which is read with your own `az login`.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "vault",
              "secret"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$",
                "description": "A unique id; matching a built-in id replaces that entry."
              },
              "label": {
                "type": "string",
                "description": "The name shown in the product dropdown."
              },
              "vault": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$",
                "description": "The Key Vault name, such as sptribs-aat."
              },
              "secret": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$",
                "description": "The secret holding the Notify API key."
              },
              "note": {
                "type": "string",
                "description": "Shown under the product dropdown."
              }
            }
          }
        }
      }
    },
    "customEditors": [
      {
        "viewType": "hmctsTemplatePreview.docxPreview",
        "displayName": "HMCTS Template Preview",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "hmctsTemplatePreview.preview",
        "title": "Preview Docmosis template",
        "category": "HMCTS Template Preview"
      },
      {
        "command": "hmctsTemplatePreview.searchTemplates",
        "title": "Search templates",
        "category": "HMCTS Template Preview",
        "icon": "$(search)"
      },
      {
        "command": "hmctsTemplatePreview.refreshTemplates",
        "title": "Refresh templates",
        "category": "HMCTS Template Preview",
        "icon": "$(refresh)"
      },
      {
        "command": "hmctsTemplatePreview.signInToGitHub",
        "title": "Sign in to GitHub for templates",
        "category": "HMCTS Template Preview"
      },
      {
        "command": "hmctsTemplatePreview.configureTemplateLibraries",
        "title": "Configure template libraries",
        "category": "HMCTS Template Preview"
      },
      {
        "command": "hmctsTemplatePreview.openLibraryTemplate",
        "title": "Preview library template",
        "category": "HMCTS Template Preview"
      },
      {
        "command": "hmctsTemplatePreview.notify.refresh",
        "title": "Refresh Notify templates",
        "category": "HMCTS Template Preview",
        "icon": "$(refresh)"
      },
      {
        "command": "hmctsTemplatePreview.notify.forgetKey",
        "title": "Forget GOV.UK Notify API keys",
        "category": "HMCTS Template Preview"
      },
      {
        "command": "hmctsTemplatePreview.notify.openTemplate",
        "title": "Open GOV.UK Notify template",
        "category": "HMCTS Template Preview"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "hmctsTemplatePreview.preview",
          "when": "resourceExtname == .docx || activeCustomEditorId == hmctsTemplatePreview.docxPreview"
        },
        {
          "command": "hmctsTemplatePreview.openLibraryTemplate",
          "when": "false"
        },
        {
          "command": "hmctsTemplatePreview.notify.openTemplate",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "hmctsTemplatePreview.preview",
          "when": "resourceExtname == .docx",
          "group": "navigation@50"
        }
      ],
      "view/title": [
        {
          "command": "hmctsTemplatePreview.searchTemplates",
          "when": "view == hmctsTemplatePreview.templates",
          "group": "navigation@1"
        },
        {
          "command": "hmctsTemplatePreview.refreshTemplates",
          "when": "view == hmctsTemplatePreview.templates",
          "group": "navigation@2"
        },
        {
          "command": "hmctsTemplatePreview.notify.refresh",
          "when": "view == hmctsTemplatePreview.notifyTemplates",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hmctsTemplatePreview",
          "title": "HMCTS Templates",
          "icon": "media/templates.svg"
        },
        {
          "id": "hmctsNotify",
          "title": "GOV.UK Notify",
          "icon": "media/notify.svg"
        }
      ]
    },
    "views": {
      "hmctsTemplatePreview": [
        {
          "id": "hmctsTemplatePreview.templates",
          "name": "Templates",
          "icon": "media/templates.svg",
          "contextualTitle": "HMCTS Templates"
        }
      ],
      "hmctsNotify": [
        {
          "type": "webview",
          "id": "hmctsTemplatePreview.notifyTemplates",
          "name": "Templates"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hmctsTemplatePreview.templates",
        "when": "hmctsTemplatePreview.templates.state == noLibraries",
        "contents": "No template libraries are configured: `hmctsTemplatePreview.templateLibraries` is empty. Reset the setting to list hmcts/rdo-docmosis again, or add the GitHub repositories that hold your templates.\n[Configure template libraries](command:hmctsTemplatePreview.configureTemplateLibraries)"
      },
      {
        "view": "hmctsTemplatePreview.templates",
        "when": "hmctsTemplatePreview.templates.state == signedOut",
        "contents": "Sign in to GitHub to list the templates in the configured repositories.\n[Sign in to GitHub](command:hmctsTemplatePreview.signInToGitHub)"
      },
      {
        "view": "hmctsTemplatePreview.templates",
        "when": "hmctsTemplatePreview.templates.state == loading",
        "contents": "Loading the template list from GitHub..."
      },
      {
        "view": "hmctsTemplatePreview.templates",
        "when": "hmctsTemplatePreview.templates.state == empty",
        "contents": "The configured libraries have no .docx templates.\n[Configure template libraries](command:hmctsTemplatePreview.configureTemplateLibraries)"
      },
      {
        "view": "hmctsTemplatePreview.templates",
        "when": "hmctsTemplatePreview.templates.state == error",
        "contents": "Couldn't load the template list.\n[Retry](command:hmctsTemplatePreview.refreshTemplates)\n[Sign in to GitHub](command:hmctsTemplatePreview.signInToGitHub)\n[Configure template libraries](command:hmctsTemplatePreview.configureTemplateLibraries)"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:integration": "npm run build && xvfb-run -a node test/integration/runTest.mjs",
    "package": "npm run build && vsce package --no-dependencies --out hmcts-template-preview.vsix && node scripts/check-vsix.mjs",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "^0.28.0",
    "fflate": "^0.8.2",
    "ovsx": "1.4.0",
    "pdfjs-dist": "^6.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@hmcts-cft/docmosis-tools": "file:.."
  }
}
